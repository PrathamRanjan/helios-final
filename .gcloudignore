# Same allowlist as Docker, plus the cloud build definition.
**
!cloudbuild.yaml
!.dockerignore
!web/
!web/**
!engine/
!engine/requirements.txt
!engine/Dockerfile
!engine/api/
!engine/api/**
!engine/helios_engine/
!engine/helios_engine/**
!engine/data/
!engine/data/registry.json
!engine/data/catalog/
!engine/data/catalog/**
**/.env
**/.env.*
**/*credentials*.json
**/*service-account*.json
**/*.pem
**/*.key
**/apis.txt
**/node_modules
**/.next
**/.next-*
**/.venv
**/__pycache__
**/*.pyc
**/*.tsbuildinfo
**/.DS_Store
**/.git
**/.cache
**/.pytest_cache
