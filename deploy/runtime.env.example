# Local container mode: use deploy/config.json + Secret Manager for Cloud Run.
# Do not commit filled credentials or pass this file as a Docker build context.
GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ENGINE_URL=http://127.0.0.1:8081
HELIOS_INTERNAL_APP_URL=http://127.0.0.1:8080
HELIOS_STORAGE_BUCKET=
# Engine container additionally needs PORT=8081 and HELIOS_APP_URL=http://127.0.0.1:8080.
# Browser key is a BUILD argument: NEXT_PUBLIC_GOOGLE_MAPS_KEY.
