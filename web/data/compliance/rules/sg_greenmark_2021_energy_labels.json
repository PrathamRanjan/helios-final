    "source": "bca_gm2021_cert_std_r3",
    "clause": "Definitions — SLE / ZE / PE; Energy Efficiency pathways",
    "pages": [4, 20],
    "quote": "A super low energy (SLE) building with 115% of all energy consumption, including plug load, supplied from onsite renewable energy sources"
  },
  "sle": {
    "min_savings_vs_2005": 0.60,
    "alt_min_savings_vs_prevailing_code": 0.40,
    "or_tier_from_rule": { "rule": "sg.greenmark2021.inop_eui", "tier": "SLE" }
  },
  "ze": { "min_renewable_share": 1.0, "offsite_recs_allowed": true, "recs_note": "Off-site RECs only for ZE (not PE), must be generated in Singapore (SS 673:2021), ≥3-year commitment." },
  "pe": { "min_onsite_renewable_share": 1.15, "offsite_recs_allowed": false },
  "notes": [
    "On-site RE used to meet Green Mark EE requirements must not also be sold as RECs (double counting).",
    "Shares are renewable kWh ÷ total building consumption incl. plug load."
  ],
