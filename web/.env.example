# Copy to .env.local and fill in your own keys. Never commit .env.local.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=
GEMINI_API_KEY=
# Use the same Gemini key here for hosted language features.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ENGINE_URL=http://127.0.0.1:8081
HELIOS_INTERNAL_APP_URL=http://127.0.0.1:3000
# Leave unset for local filesystem storage; Cloud Run config supplies a bucket.
HELIOS_STORAGE_BUCKET=
